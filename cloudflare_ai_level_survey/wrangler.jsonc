{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-usage-level-survey",
  "main": "worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ADMIN_PIN": "admin888"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "org-ai-survey-db",
      "database_id": "c4a1e0bd-b699-4fa0-969b-3b1768ffc37e"
    }
  ]
}
